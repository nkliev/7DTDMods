<config>
	<remove xpath="/windows/window[@name='mainMenuNews']/rect"/>
	<remove xpath="/windows/window[@name='mainMenuPlayerName']/label"/>
	<remove xpath="/windows/window[@name='mainMenuVersion']/label"/>
	<!--<remove xpath="/windows/window[@name='menuBackground']/video[@name='videoTexture']"/>--><!--mini edit-->
	<remove xpath="/windows/window[@name='mainMenu']/texture[@name='gameLogo']"/>
	
	<append xpath="/windows">
		<window name="mainMenuLogo" anchor="CenterCenter" pos="0,0" width="1050" height="780" depth="-2">
			<texture depth="3" color="[white]" texture="@:Textures/UI/7DTD_logo.tga" name="gameLogo" anchor_left="#cam,0.5,-20" anchor_bottom="#cam,0.5,20" anchor_right="#cam,0.5,-20" anchor_top="#cam,0.5,490" pivot="center" keep_aspect_ratio="BasedOnHeight" aspect_ratio="2.3" visible="true"/>
		</window>
	</append>
	
	<setattribute xpath="/windows/window[@name='mainMenu']" name="anchor">Center</setattribute>
	<setattribute xpath="/windows/window[@name='mainMenu']" name="pos">0,0</setattribute>
	<setattribute xpath="/windows/window[@name='mainMenu']/grid" name="pos">0,0</setattribute>
	<setattribute xpath="/windows/window[@name='mainMenu']/grid" name="cell_alignment">center</setattribute>
	
	<remove xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnDlc']"/>
	<remove xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnCredits']"/>
	<remove xpath="/windows/window[@name='mainMenu']/grid/mainmenubutton[@name='btnNews']"/>
	
    <!--<setattribute xpath="/windows/window[@name='menuBackground']/texture" name="texture">@modfolder:UIAtlases/bg-forest.jpg</setattribute>--><!--mini edit-->
</config>
