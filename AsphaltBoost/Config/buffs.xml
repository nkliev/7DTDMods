<config>
	<append xpath="/buffs">
		<buff name="buffAsphaltBoostStart" hidden="true">
			<stack_type value="effect"/>
			<duration value="1"/>
	
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="AddBuff" buff="buffAsphaltBoost"/>
				<triggered_effect trigger="onSelfBuffStack" action="AddBuff" buff="buffAsphaltBoost"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar=".buffAsphaltBoostDuration" operation="add" value="2">
					<requirement name="CVarCompare" cvar=".buffAsphaltBoostDuration" operation="LTE" value="8"/>
				</triggered_effect>
			</effect_group>
		</buff>
		<buff name="buffAsphaltBoost" name_key="asphaltBoostName" description_key="asphaltBoostDesc" icon="ui_game_symbol_run" showonhud="false" icon_color="255,255,255">
			<stack_type value="replace"/>
			<duration value="0"/>
			<display_value value=".buffAsphaltBoostDuration"/>
			<display_value_format value="time"/>
			
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="ModifyCVar" cvar=".buffAsphaltBoostDuration" operation="subtract" value="1">
					<requirement name="!HasBuff" buff="buffAsphaltBoostStart"/>
				</triggered_effect>
			</effect_group>
			<effect_group>
				<triggered_effect trigger="onSelfBuffUpdate" action="RemoveBuff" buff="buffAsphaltBoost">
					<requirement name="CVarCompare" cvar=".buffAsphaltBoostDuration" operation="LTE" value="0"/>
				</triggered_effect>
				<triggered_effect trigger="onSelfBuffRemove" action="ModifyCVar" cvar=".buffAsphaltBoostDuration" operation="set" value="0"/>
			</effect_group>
			
			<effect_group>
				<!--<passive_effect name="StaminaLoss" operation="perc_add" value="-.2" tags="walking"/>
				<passive_effect name="StaminaLoss" operation="perc_add" value="-.2" tags="running"/>-->
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".15" tags="walking"/>
				<passive_effect name="StaminaChangeOT" operation="perc_add" value=".15" tags="running"/>
				<passive_effect name="WaterLossPerStaminaPointGained" operation="perc_add" value=".2" tags="walking"/>
				<passive_effect name="WaterLossPerStaminaPointGained" operation="perc_add" value="-.2" tags="running"/>
				
				<passive_effect name="WalkSpeed" operation="perc_add" value=".15"/>
				<passive_effect name="RunSpeed" operation="perc_add" value=".1"/>
				<passive_effect name="Mobility" operation="perc_add" value=".05"/>
				
				<passive_effect name="VehiclePlayerStaminaDrainRate" operation="perc_add" value="-.3"/>
				<passive_effect name="VehicleFuelUsePer" operation="perc_add" value="-.3"/>
				<passive_effect name="VehicleVelocityMaxPer" operation="perc_add" value="0.2"/>
				<passive_effect name="VehicleMotorTorquePer" operation="perc_add" value="0.2"/>
			</effect_group>
		</buff>
	</append>
</config>