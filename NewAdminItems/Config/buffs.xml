<config>
	<append xpath="/buffs">
		<buff name="admin_buffInfiniteAmmo" remove_on_death="false" showonhud="false">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="InfiniteAmmo" operation="base_set" value="1"/>
			</effect_group>
		</buff>
		<buff name="admin_buffUnbreakableItems" remove_on_death="false" showonhud="false">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="DegradationPerUse" operation="base_set" value="0"/>
			</effect_group>
		</buff>
		<buff name="admin_buffFastReload" remove_on_death="false" showonhud="false">
			<stack_type value="ignore"/>
			<effect_group>
				<passive_effect name="ReloadSpeedMultiplier" operation="perc_add" value="2"/>
			</effect_group>
		</buff>
		<buff name="buffGiveThreeHundredPoints" description="Gives three hundred points" icon="ui_game_symbol_lightbulb" icon_color="255,175,175" hidden="true">
			<stack_type value="ignore"/>
			<duration value="1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="CallGameEvent" event="action_give_three_hundred_points"/>
			</effect_group>
		</buff>
	</append>
</config>