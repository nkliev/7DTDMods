<config>
	<set xpath="//property[@name='allow_user_trigger']/@value">true</set>
	<append xpath="/gameevents">
		<action_sequence name="action_give_three_hundred_points">
			<action class="AddSkillPoints">
				<property name="skill_points" value="300" />
			</action>
		</action_sequence>
	</append>
</config>