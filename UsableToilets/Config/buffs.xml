<config>
	<append xpath="/buffs">
		<buff name="buffOnToilet" hidden="true">
			<stack_type value="ignore"/>
			<duration value=".34"/>
			<effect_group>
			<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="$dysenteryCounter" operation="subtract" value="20">
				<requirement name="CVarCompare" cvar="$dysenteryCounter" operation="GT" value="0"/>
				<requirement name="CVarCompare" cvar="_crouching" operation="Equals" value="1"/>
			</triggered_effect>
			<triggered_effect trigger="onSelfBuffStart" action="PlaySound" sound="shittinglol">
				<requirement name="CVarCompare" cvar="$dysenteryCounter" operation="GT" value="0"/>
				<requirement name="CVarCompare" cvar="_crouching" operation="Equals" value="1"/>
			</triggered_effect>
			</effect_group>
		</buff>
	</append>
</config>